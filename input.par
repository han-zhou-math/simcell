$PARAM
  CFL = 0.1
  ! Dimensionless viscosity nu*=mu/(P0*T0).  With the scales below, nu*=0.05
  ! corresponds to mu=5.0e-5 Pa s; this is a numerical demo, not the JTB map.
  nu  = .05
  ! Stage 05 is the clean Stokes/FSI baseline.  Nonzero spatially varying
  ! Brinkman drag requires the later variable-coefficient Brinkman solver;
  ! lagging it on the Stokes right-hand side is not stable on this domain.
  bke = 0.0
  bki = 0.0
  vco = 1.
  ntmax = 100
  nfreq =  5
  dlt   = 0.005

  ! Physical reference scales for the chemical-to-code map:
  ! L0=40 um, T0=1000 s, U0=L0/T0=0.04 um/s, C_S=0.1 mM.
  scale_length_um = 40.0
  scale_concentration_millimolar = 0.1
  scale_velocity_um_s = 0.04
  scale_time_s = 1000.0
  scale_stress_pa = 1.0e-6

  ! One common physical diffusion is required by the accepted hybrid solver.
  dualchem_diffusion = 1.0
  dualchem_kc = 0.01
  dualchem_kp = 1.0
  dualchem_initial_concentration = 1.0
  dualchem_initial_polarization = 0.0
  enable_osmotic_feedback = .true.
  water_osmotic_mobility = 1.0
  water_stress_mobility = 4.0091e-9
  stage12_actin_gamma = 0.5
  stage12_actin_jc = 0.24
  stage12_actin_dw = 1.0
  stage12_actin_theta0 = 1.0
  stage12_localized_polymerization = .true.
  stage14_recenter_interface = .false.
  stage14_shape_force_scale = 1.0
  ! Signed net x-load per unit out-of-plane depth, scaled by P0*L0.
  ! Negative values oppose migration toward +x.
  stage14_external_load_x = 0.0
  initial_cell_radius = 0.249
  initial_cell_axis_ratio = 1.0
$END
